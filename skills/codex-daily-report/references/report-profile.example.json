  "scope_override_max_chars": 500,
  "work_cwd_patterns": [],
  "exclude_cwd_patterns": [],
  "work_keywords": [],
  "exclude_turn_patterns": [],
  "report_maintenance_patterns": [],
  "submitted_exclude_patterns": [],
